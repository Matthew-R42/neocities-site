# Pages defaults to "public, max-age=14400, must-revalidate". must-revalidate
# only bites once the freshness window is over, so for four hours after a
# deploy browsers and the edge kept serving the previous page without asking.
#
# max-age=0 makes every response stale on arrival, so must-revalidate turns
# each request into a conditional one. Unchanged files come back as a 304 with
# no body, which is cheap, and a deploy is visible immediately.
/*
  Cache-Control: public, max-age=0, must-revalidate

# The riichi bundle is a webpack build with content hashes in the filenames, so
# a changed file is always a new URL and these can be cached hard.
/riichi/static/*
  Cache-Control: public, max-age=31536000, immutable
